{
  "manifest_version": 3,
  "name": "CourierPR.com",
  "description": "The latest press releases on CourierPR.com, plus the newest in five categories picked fresh each time you open it.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "CourierPR.com",
    "default_popup": "popup.html"
  }
}
